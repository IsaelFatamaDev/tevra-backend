<div style="font-family: 'Segoe UI', Arial, sans-serif; color: #333; max-width: 600px; margin: 0 auto; border: 1px solid #e0e0e0; border-radius: 12px; overflow: hidden; background-color: #ffffff;">

  <!-- Header with logo -->
  <div style="background-color: #ffffff; padding: 36px 24px; text-align: center; border-bottom: 1px solid #e0e0e0;">
    <img src="https://tevra.ddns.net/LogoTevra.png" alt="TeVra"
      style="height: 60px; width: auto; object-fit: contain; display: block; margin: 0 auto 12px;"
      onerror="this.onerror=null; this.style.display='none'; this.insertAdjacentHTML('afterend', '<div style=&quot;color:#0a2540;font-size:26px;font-weight:900;letter-spacing:-1px;text-align:center;margin-bottom:12px;&quot;>Te<span style=&quot;color:#90CAF9;&quot;>Vra</span></div>');" />
    <p style="color: #718096; margin: 0; font-size: 11px; font-weight: 700; letter-spacing: 0.3em; text-transform: uppercase;">Importaciones Premium desde USA</p>
  </div>

  <!-- Body -->
  <div style="padding: 36px 32px;">
    {{{content}}}
  </div>

  <!-- Footer -->
  <div style="background-color: #f7fafc; padding: 20px 32px; text-align: center; border-top: 1px solid #e2e8f0;">
    <p style="margin: 0 0 4px; font-size: 12px; color: #a0aec0;">© 2026 TeVra LLC. Todos los derechos reservados.</p>
    <p style="margin: 0; font-size: 11px; color: #cbd5e0;">Recibes este correo porque estás registrado/a en TeVra.</p>
  </div>

</div>
