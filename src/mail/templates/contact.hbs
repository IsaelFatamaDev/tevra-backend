<div style="font-family: 'Segoe UI', Arial, sans-serif; color: #333; max-width: 600px; margin: 0 auto; border: 1px solid #e0e0e0; border-radius: 12px; overflow: hidden; background-color: #ffffff;">

  <!-- Header -->
  <div style="background-color: #ffffff; padding: 36px 24px; text-align: center; border-bottom: 1px solid #e0e0e0;">
    <img src="https://tevra.ddns.net/LogoTevra.png" alt="TeVra" style="height: 60px; width: auto; object-fit: contain; display: block; margin: 0 auto 12px;" />
    <p style="color: #718096; margin: 0; font-size: 11px; font-weight: 700; letter-spacing: 0.3em; text-transform: uppercase;">Mensaje de Contacto</p>
  </div>

  <!-- Body -->
  <div style="padding: 36px 32px;">
    <h2 style="color: #0a2540; margin: 0 0 8px; font-size: 20px; font-weight: 700;">Nuevo mensaje desde el formulario de contacto</h2>
    <p style="color: #718096; font-size: 13px; margin: 0 0 28px;">Alguien se ha puesto en contacto a través del sitio web.</p>

    <!-- Contact details -->
    <div style="background-color: #f7fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 20px 24px; margin: 0 0 24px;">
      <table style="width: 100%; border-collapse: collapse;">
        <tr>
          <td style="padding: 8px 0; color: #718096; font-size: 13px; width: 110px; vertical-align: top;">Nombre:</td>
          <td style="padding: 8px 0; font-weight: 700; color: #2d3748;">{{name}}</td>
        </tr>
        <tr>
          <td style="padding: 8px 0; color: #718096; font-size: 13px; vertical-align: top;">Correo:</td>
          <td style="padding: 8px 0; color: #2d3748;"><a href="mailto:{{senderEmail}}" style="color: #4a90d9; text-decoration: none;">{{senderEmail}}</a></td>
        </tr>
        <tr>
          <td style="padding: 8px 0; color: #718096; font-size: 13px; vertical-align: top;">Asunto:</td>
          <td style="padding: 8px 0; font-weight: 700; color: #2d3748;">{{subject}}</td>
        </tr>
      </table>
    </div>

    <!-- Message -->
    <p style="color: #718096; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; margin: 0 0 8px;">Mensaje:</p>
    <div style="background-color: #fffdf7; border-left: 4px solid #468189; border-radius: 0 8px 8px 0; padding: 16px 20px; color: #2d3748; line-height: 1.7; white-space: pre-line;">{{message}}</div>

    <hr style="border: none; border-top: 1px solid #e2e8f0; margin: 28px 0;">

    <p style="font-size: 13px; color: #a0aec0; margin: 0;">
      Para responder, escribe directamente a <a href="mailto:{{senderEmail}}" style="color: #468189; text-decoration: none; font-weight: 600;">{{senderEmail}}</a>
    </p>
  </div>

  <!-- Footer -->
  <div style="background-color: #f7fafc; padding: 20px 32px; text-align: center; border-top: 1px solid #e2e8f0;">
    <p style="margin: 0 0 4px; font-size: 12px; color: #a0aec0;">© 2026 TeVra LLC. Todos los derechos reservados.</p>
    <p style="margin: 0; font-size: 11px; color: #cbd5e0;">Mensaje generado automáticamente desde tevra.ddns.net</p>
  </div>

</div>
